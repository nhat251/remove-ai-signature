{
  "name": "remove-ai-signature",
  "version": "1.1.0",
  "description": "Model Context Protocol (MCP) server to detect, remove AI watermarks, signatures and strip EXIF/C2PA/video metadata directly on your local filesystem for images and videos.",
  "main": "dist/index.js",
  "bin": {
    "remove-ai-signature": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && chmod +x dist/index.js",
    "prepublishOnly": "pnpm build",
    "start": "node dist/index.js"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ai-watermark",
    "ai-signature",
    "ai-video-watermark",
    "video-metadata-stripper",
    "c2pa",
    "exif-stripper",
    "delogo",
    "ffmpeg",
    "cursor",
    "claude",
    "ghostmark"
  ],
  "author": "Nhat Nguyen",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
